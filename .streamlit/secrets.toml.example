# Template for Streamlit Community Cloud → your app → Settings → Secrets.
# Fill in the three placeholders (CAPITALS), then paste the whole thing.
# For a local test you may copy it to .streamlit/secrets.toml (git-ignored; never commit it).

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY = "PASTE-YOUR-GEMINI-API-KEY"
GEMINI_MODEL = "gemini-3.8-flash"

# Neon → your project → Connect → copy the full connection string
DATABASE_URL = "PASTE-YOUR-NEON-CONNECTION-STRING"

# Loads the two reference records (approved vendor + blocklist entry) at startup,
# replacing `python database.py --seed ...`. Safe to leave on: it never duplicates rows.
SEED_FILE = "sample_data/seed_db_records.json"

APP_TIMEZONE = "Asia/Kolkata"

# Reviewer quick-start panel + "Reset demo approvals" button
PUBLIC_DEMO = "true"
TEST_PACK_URL = "https://github.com/YOUR-GITHUB-USERNAME/vendor-onboarding-demo/raw/main/reviewer_test_pack.zip"
