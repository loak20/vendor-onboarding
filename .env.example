# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey and paste it after the = sign.
GEMINI_API_KEY=

# Optional: any Gemini model that accepts images/PDF and returns structured JSON.
GEMINI_MODEL=gemini-3.8-flash

# Optional: where the SQLite database lives (default: ./vendor_onboarding.db)
# VENDOR_DB_PATH=./vendor_onboarding.db

# --- Optional settings used by the hosted demo (see DEPLOYMENT.md) ---------------
# Use PostgreSQL (e.g. a free Neon database) instead of the local SQLite file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Load the reference records once at app startup instead of running
# `python database.py --seed ...`. Idempotent; fills only approved_vendors and blocklist.
# SEED_FILE=sample_data/seed_db_records.json

# Time zone for stored timestamps (cloud servers run on UTC).
# APP_TIMEZONE=Asia/Kolkata

# Show the reviewer quick-start panel and the "Reset demo approvals" button.
# PUBLIC_DEMO=true
# TEST_PACK_URL=https://github.com/YOUR-GITHUB-USERNAME/vendor-onboarding-demo/raw/main/reviewer_test_pack.zip


